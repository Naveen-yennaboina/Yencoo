// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum LearningMode {
  TEXT
  AUDIO
  INTERACTIVE
}

enum MembershipType {
  FREE
  BASIC
  PREMIUM
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum OTPPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  LOGIN
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model Language {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(10)
  name       String
  nativeName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userPreferences UserPreference[]
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  slug      String     @unique
  parentId  String?    @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryToCategory")
  courses   Course[]

  @@index([parentId])
}

model Country {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(2)
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  hashedPassword String?
  firstName      String?
  lastName       String?
  avatarUrl      String?
  role           UserRole  @default(USER)
  countryId      String?   @db.Uuid
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? // Soft delete

  country        Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  
  preference     UserPreference?
  
  otpCodes       OTPCode[]
  payments       Payment[]
  enrollments    Enrollment[]
  bookmarks      Bookmark[]
  userRoadmaps   UserRoadmap[]
  feedbacks      Feedback[]

  @@index([email])
}

model OTPCode {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  code      String
  purpose   OTPPurpose
  expiresAt DateTime
  createdAt DateTime   @default(now())
  
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserPreference {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @unique @db.Uuid
  preferredLanguageId String?      @db.Uuid
  preferredVoice      String?
  preferredLearningMode LearningMode @default(TEXT)
  preferredTimezone   String?
  preferredCurrency   String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  language            Language?    @relation(fields: [preferredLanguageId], references: [id], onDelete: SetNull)
}

model Membership {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         
  type        MembershipType @unique
  price       Decimal        @db.Decimal(10, 2)
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  payments    Payment[]
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  membershipId String?       @db.Uuid
  amount       Decimal       @db.Decimal(10, 2)
  status       PaymentStatus @default(PENDING)
  providerId   String?       // e.g., Razorpay order ID
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   Membership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model Course {
  id              String          @id @default(uuid()) @db.Uuid
  title           String
  slug            String          @unique
  description     String?         @db.Text
  thumbnailUrl    String?
  status          CourseStatus    @default(DRAFT)
  difficultyLevel DifficultyLevel @default(BEGINNER)
  audioEnabled         Boolean         @default(false)
  aiExplanationEnabled Boolean         @default(false)
  translationEnabled   Boolean         @default(false)
  estimatedAudioDuration Int?          // in minutes
  categoryId      String?         @db.Uuid
  learningOutcomes String[]
  requirements    String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?       // Soft delete

  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  modules         CourseModule[]
  enrollments     Enrollment[]
  roadmapCourses  RoadmapCourse[]
  feedbacks       Feedback[]

  @@index([status])
  @@index([slug])
  @@index([categoryId])
}

model CourseModule {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId])
  @@unique([courseId, order])
}

model Lesson {
  id          String   @id @default(uuid()) @db.Uuid
  moduleId    String   @db.Uuid
  title       String
  content     String?  @db.Text
  videoUrl    String?
  order       Int      @default(0)
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module      CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  bookmarks   Bookmark[]

  @@index([moduleId])
  @@unique([moduleId, order])
}

model Enrollment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  courseId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  progress  LessonProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id           String   @id @default(uuid()) @db.Uuid
  enrollmentId String   @db.Uuid
  lessonId     String   @db.Uuid
  isCompleted  Boolean  @default(false)
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
}

model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  lessonId  String   @db.Uuid
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model Roadmap {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete

  courses     RoadmapCourse[]
  users       UserRoadmap[]
}

model RoadmapCourse {
  id        String   @id @default(uuid()) @db.Uuid
  roadmapId String   @db.Uuid
  courseId  String   @db.Uuid
  order     Int      @default(0)
  createdAt DateTime @default(now())

  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, courseId])
  @@index([roadmapId])
}

model UserRoadmap {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roadmapId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
  @@index([userId])
}

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  courseId  String   @db.Uuid
  rating    Int      @db.SmallInt
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId])
}
